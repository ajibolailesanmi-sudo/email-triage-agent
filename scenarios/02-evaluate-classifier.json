  {
   "id": 9,
   "module": "builtin:BasicRouter",
   "version": 1,
   "routes": [
    {
     "flow": [
      {
       "id": 10,
       "module": "http:MakeRequest",
       "version": 4,
       "parameters": {
        "tlsType": "",
        "apiKeyAccount": 0,
        "authenticationType": "apiKeyConnection"
       },
       "mapper": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/{{replace(get(map(2.array; \"value\"; \"key\"; \"model\"); 1); \"models/\"; emptystring)}}:generateContent",
        "method": "post",
        "timeout": "60",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"systemInstruction\":{\"parts\":[{\"text\":\"{{replace(replace(replace(replace(replace(replace(replace(replace(3.`0`; \"/\\{\\{team_name\\}\\}/g\"; get(map(2.array; \"value\"; \"key\"; \"team_name\"); 1)); \"/\\{\\{reply_templates\\}\\}/g\"; 5.text); \"/\\\\/g\"; \"\\\\\"); \"/\"\"/g\"; \"\\\"\"\"); \"/\\n/g\"; \"\\n\"); \"/\\r/g\"; emptystring); \"/\\t/g\"; \"\\t\"); \"/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g\"; emptystring)}}\"}]},\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"From: {{replace(replace(replace(replace(replace(replace(6.`1`; \"/\\\\/g\"; \"\\\\\"); \"/\"\"/g\"; \"\\\"\"\"); \"/\\n/g\"; \"\\n\"); \"/\\r/g\"; emptystring); \"/\\t/g\"; \"\\t\"); \"/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g\"; emptystring)}} <{{replace(replace(replace(replace(replace(replace(6.`2`; \"/\\\\/g\"; \"\\\\\"); \"/\"\"/g\"; \"\\\"\"\"); \"/\\n/g\"; \"\\n\"); \"/\\r/g\"; emptystring); \"/\\t/g\"; \"\\t\"); \"/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g\"; emptystring)}}>\\nSubject: {{replace(replace(replace(replace(replace(replace(6.`3`; \"/\\\\/g\"; \"\\\\\"); \"/\"\"/g\"; \"\\\"\"\"); \"/\\n/g\"; \"\\n\"); \"/\\r/g\"; emptystring); \"/\\t/g\"; \"\\t\"); \"/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g\"; emptystring)}}\\n\\n{{replace(replace(replace(replace(replace(replace(6.`4`; \"/\\\\/g\"; \"\\\\\"); \"/\"\"/g\"; \"\\\"\"\"); \"/\\n/g\"; \"\\n\"); \"/\\r/g\"; emptystring); \"/\\t/g\"; \"\\t\"); \"/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g\"; emptystring)}}\"}]}],\"generationConfig\":{\"temperature\":0,\"maxOutputTokens\":2048,\"responseMimeType\":\"application/json\",\"responseSchema\":{\"type\":\"object\",\"required\":[\"category\",\"urgency\",\"confidence\",\"summary\",\"sender_name\",\"company\",\"key_facts\",\"sentiment\",\"language\",\"needs_human\",\"needs_human_reason\",\"suggested_reply\"],\"propertyOrdering\":[\"category\",\"urgency\",\"confidence\",\"summary\",\"sender_name\",\"company\",\"key_facts\",\"sentiment\",\"language\",\"needs_human\",\"needs_human_reason\",\"suggested_reply\"],\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"support_request\",\"sales_inquiry\",\"billing_question\",\"scheduling\",\"vendor_or_marketing\",\"automated_notification\",\"unclear\"]},\"urgency\":{\"type\":\"string\",\"enum\":[\"urgent\",\"normal\",\"low\"]},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1,\"description\":\"Confidence in the category, 0 to 1\"},\"summary\":{\"type\":\"string\",\"description\":\"What the sender wants, 30 words or fewer, in English\"},\"sender_name\":{\"type\":\"string\",\"nullable\":true},\"company\":{\"type\":\"string\",\"nullable\":true},\"key_facts\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"maxItems\":8},\"sentiment\":{\"type\":\"string\",\"enum\":[\"positive\",\"neutral\",\"frustrated\"]},\"language\":{\"type\":\"string\",\"description\":\"ISO 639-1 code of the email body, for example en or de\"},\"needs_human\":{\"type\":\"boolean\"},\"needs_human_reason\":{\"type\":\"string\",\"nullable\":true},\"suggested_reply\":{\"type\":\"string\",\"nullable\":true,\"description\":\"Draft reply for support_request, sales_inquiry, billing_question and scheduling only; null otherwise. 120 words or fewer\"}}}}}"
       },
       "filter": {
        "name": "A row to score",
        "conditions": [
         [
          {
           "a": "{{6.`__IMTLENGTH__`}}",
           "o": "number:greater",
           "b": "0"
          }
         ]
        ]
       },
       "onerror": [
        {
         "id": 22,
         "module": "builtin:Ignore",
         "version": 1,
         "metadata": {
          "designer": {
           "x": 2400,
           "y": -450
          }
         }
        }
       ],
       "metadata": {
        "designer": {
         "x": 2400,
         "y": -150,
         "name": "Gemini: classify"
        }
       }
      },
      {
       "id": 11,
       "module": "json:ParseJSON",
       "version": 1,
       "parameters": {},
