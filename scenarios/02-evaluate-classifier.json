         "12": "{{11.urgency}}",
         "13": "{{if(11.needs_human; \"TRUE\"; \"FALSE\")}}",
         "14": "{{if(contains(\"support_request,sales_inquiry,billing_question,scheduling\"; 11.category); if(length(ifempty(11.suggested_reply; emptystring)) > 0; \"TRUE\"; \"FALSE\"); \"FALSE\")}}",
         "15": "{{if(11.category = 6.`5`; 1; 0)}}",
         "16": "{{if(11.urgency = 6.`6`; 1; 0)}}",
         "17": "{{if(if(11.needs_human; \"TRUE\"; \"FALSE\") = upper(6.`7`); 1; 0)}}",
         "18": "{{if(if(contains(\"support_request,sales_inquiry,billing_question,scheduling\"; 11.category); if(length(ifempty(11.suggested_reply; emptystring)) > 0; \"TRUE\"; \"FALSE\"); \"FALSE\") = upper(6.`8`); 1; 0)}}",
         "19": "{{if(length(6.`9`) = 0; 1; if(contains(lower(11.suggested_reply); lower(6.`9`)); 0; 1))}}",
         "20": "{{11.confidence}}",
         "21": "{{formatDate(now; \"YYYYMMDD-HHmm\")}}"
        }
       },
       "metadata": {
        "designer": {
         "x": 3000,
         "y": -150,
         "name": "Write prediction"
        }
