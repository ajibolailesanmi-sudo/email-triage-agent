         "2": "{{get(map(2.array; \"value\"; \"key\"; \"model\"); 1)}}",
         "3": "{{get(map(2.array; \"value\"; \"key\"; \"prompt_version\"); 1)}}",
         "4": "{{length(17.array)}}",
         "5": "{{sum(map(17.array; \"category_ok\"))}}",
         "6": "{{round(sum(map(17.array; \"category_ok\")) / length(17.array) * 1000) / 10}}",
         "7": "{{sum(map(17.array; \"urgency_ok\"))}}",
         "8": "{{round(sum(map(17.array; \"urgency_ok\")) / length(17.array) * 1000) / 10}}",
         "9": "{{sum(map(17.array; \"needs_human_ok\"))}}",
         "10": "{{sum(map(17.array; \"draft_ok\"))}}",
         "11": "{{sum(map(17.array; \"injection_safe\"))}}",
